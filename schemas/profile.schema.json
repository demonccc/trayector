{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/demonccc/trayector/schemas/profile.schema.json",
  "title": "Trayector Profile",
  "type": "object",
  "required": ["trayector_version", "profile", "navigation"],
  "properties": {
    "trayector_version": {
      "type": "string"
    },
    "trayector": {
      "type": "object",
      "properties": {
        "instructions": { "type": "string" },
        "profile_kit_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "location": { "type": "string" }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "properties": {
        "settings": { "type": "string" },
        "summary": { "type": "string" },
        "timeline": { "type": "string" },
        "capabilities": { "type": "string" },
        "education": { "type": "string" },
        "feedback": { "type": "string" },
        "experience": { "type": "string" },
        "deep_dives": { "type": "string" },
        "projects": { "type": "string" },
        "stories": { "type": "string" },
        "content": { "type": "string" },
        "generated": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
